{
	"$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
	"html": {
		"experimentalFullSupportEnabled": true
	},
	"files": {
		"includes": [
			"src/**",
			"tests/**",
			"*.ts",
			"*.json"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": {
				"useButtonType": "off",
				"noSvgWithoutTitle": "off"
			},
			"suspicious": {
				"noTsIgnore": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off"
					}
				}
			}
		}
	]
}
